---
/*
 * Guide: how to add your own HTML and CSS to Wix, and keep it editable.
 * Every Wix claim is backed by a Wix page listed in WIX and SOURCES below (checked November 2026).
 * Code Canvas facts follow its App Market listing and help pages. Do not add prices (Wix localises
 * them) or claims about search results, speed, rankings or user numbers.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import ImageSlot from '../../components/ImageSlot.astro';
import { PAGES, SITE } from '../../data/site';
import { APPS } from '../../data/apps';

const page = PAGES.guideHtmlCss;
const HEADLINE = 'How to add your own HTML and CSS to Wix (and keep it editable)';

/** When the Wix details were last checked against Wix's docs. Update it when rechecking or publishing. */
const CHECKED = { iso: '2026-11-27', label: 'November 2026' };

const codeCanvas = APPS.find((a) => a.slug === 'code-canvas');
if (!codeCanvas?.marketUrl || !codeCanvas.helpUrl) throw new Error('Guide: Code Canvas needs marketUrl and helpUrl in src/data/apps.ts.');
const MARKET = codeCanvas.marketUrl;
const HELP = codeCanvas.helpUrl;
const help = (path: string) => `${HELP}/${path}`;

/** Wix pages that back the claims in this guide. */
const WIX = {
  embedEditor: 'https://support.wix.com/en/article/wix-editor-embedding-a-site-or-a-widget',
  embedStudio: 'https://support.wix.com/en/article/studio-editor-adding-an-html-iframe-element',
  embedMobile: 'https://support.wix.com/en/article/wix-editor-html-code-on-mobile',
  htmlComponent: 'https://dev.wix.com/docs/velo/velo-only-apis/$w/html-component/introduction',
  ceEditor: 'https://support.wix.com/en/article/wix-editor-adding-a-custom-element-to-your-site',
  ceStudio: 'https://support.wix.com/en/article/studio-editor-adding-a-custom-element',
  ceVelo: 'https://dev.wix.com/docs/velo/velo-only-apis/$w/custom-element/introduction',
  cssStudio: 'https://support.wix.com/en/article/studio-editor-about-css-editing',
  cssEditor: 'https://support.wix.com/en/article/wix-editor-request-accessing-the-css-code-style-sheet-of-your-site',
  customCode: 'https://support.wix.com/en/article/wix-editor-embedding-custom-code-on-your-site',
  planDomain: 'https://support.wix.com/en/article/wix-premium-plan-pricing',
  importRequest: 'https://support.wix.com/en/article/request-importing-a-site-created-outside-of-wix',
  headlessUpload: 'https://support.wix.com/en/article/wix-headless-uploading-html-files-or-a-static-site',
  studioTwoImport: 'https://support.wix.com/en/article/studio-two-editor-exporting-and-importing-site-code-files',
  harmonyEmbed: 'https://support.wix.com/en/article/wix-harmony-editor-embedding-a-link-or-html-code',
  studioTwoEmbed: 'https://support.wix.com/en/article/studio-two-editor-embedding-a-link-or-html-code',
  headings: 'https://support.wix.com/en/article/managing-your-pages-heading-tags',
  forms: 'https://support.wix.com/en/article/wix-forms-adding-and-setting-up-a-form-on-your-site',
};

const SOURCES = [
  { href: WIX.embedEditor, title: 'Wix Editor: Embedding a Site or a Widget' },
  { href: WIX.embedStudio, title: 'Studio Editor: Adding an HTML iFrame Element' },
  { href: WIX.embedMobile, title: 'Wix Editor: HTML Code on Mobile' },
  { href: WIX.htmlComponent, title: 'Velo: HtmlComponent introduction' },
  { href: WIX.ceEditor, title: 'Wix Editor: Adding a Custom Element to Your Site' },
  { href: WIX.ceStudio, title: 'Studio Editor: Adding a Custom Element' },
  { href: WIX.ceVelo, title: 'Velo: Custom element introduction' },
  { href: WIX.cssStudio, title: 'Studio Editor: About CSS Editing' },
  { href: WIX.cssEditor, title: 'Wix Editor Request: Accessing the CSS Code (Style Sheet) of Your Site' },
  { href: WIX.customCode, title: 'Wix Editor: Embedding Custom Code on Your Site' },
  { href: WIX.planDomain, title: 'Wix Premium Plan Pricing' },
  { href: WIX.importRequest, title: 'Request: Importing a Site Created Outside of Wix' },
  { href: WIX.headlessUpload, title: 'Wix Headless: Uploading HTML Files or a Static Site' },
  { href: WIX.studioTwoImport, title: 'Studio Two Editor: Exporting and Importing Site Code Files' },
  { href: WIX.harmonyEmbed, title: 'Wix Harmony Editor: Embedding a Link or HTML Code' },
  { href: WIX.studioTwoEmbed, title: 'Studio Two Editor: Embedding a Link or HTML Code' },
  { href: WIX.headings, title: "Managing Your Page's Heading Tags" },
  { href: WIX.forms, title: 'Wix Forms: Adding and Setting Up a Form on Your Site' },
];

/** External link markup for the FAQ answers, matching the rest of the site. */
const ext = (href: string, text: string) =>
  `<a href="${href}" target="_blank" rel="noopener">${text}<span class="visually-hidden"> (opens in a new tab)</span></a>`;

/** One list feeds both the visible FAQ and the FAQPage structured data, so they always match. */
const FAQ: { id: string; q: string; a: string[] }[] = [
  {
    id: 'faq-upload',
    q: 'Can I upload an HTML file to Wix?',
    a: [
      `Not as a page in the Wix Editor or Wix Studio. Wix lists ${ext(WIX.importRequest, 'importing a site built outside Wix')} as a feature request that is not supported yet. Instead, you paste code into an element: the Embed code element, which shows it in an iframe, or an app such as Code Canvas.`,
      `To host a whole static site, ${ext(WIX.headlessUpload, 'Wix Headless')} accepts HTML, CSS, JavaScript and asset files you upload, up to 20 MB in total. That creates a separate Headless site, and each new upload replaces the whole site.`,
    ],
  },
  {
    id: 'faq-javascript',
    q: 'Will my JavaScript work?',
    a: [
      'In an Embed code element, usually yes. Wix runs the code in a sandboxed iframe with scripts allowed, but the code cannot reach the rest of your page. A custom element runs JavaScript too.',
      'In Code Canvas, no. The importer removes scripts, and the import report lists what it removed. Hover states, transitions and animations can often be written in CSS instead.',
    ],
  },
  {
    id: 'faq-forms',
    q: 'Can I keep the contact form from my HTML?',
    a: [
      `Not in Code Canvas. Pasted forms are disabled and cannot send submissions, so add a ${ext(WIX.forms, 'Wix Form')} below the section. Wix's Studio guide says form submission is allowed inside the Embed code frame, so a form there can submit to whatever service its code uses.`,
    ],
  },
  {
    id: 'faq-responsive',
    q: 'Will the section be responsive on phones?',
    a: [
      `In ${ext(WIX.embedEditor, 'its guide for the Wix Editor')}, Wix says code in an Embed code element won't be responsive, even if it was responsive originally, because the element is an iframe. ${ext(WIX.embedStudio, 'Its Wix Studio guide')} notes that fixed pixel sizes in the code can crop the content.`,
      'Code Canvas renders your section in the page at full width. You set styles for Desktop, Tablet (up to 1024 px wide) and Mobile (up to 480 px wide), and check each size in the editor before you publish.',
    ],
  },
  {
    id: 'faq-clients',
    q: 'Can my clients edit it without breaking the layout?',
    a: [
      'With Code Canvas Pro, yes. In Client mode with Content only access, clients can update text, images, links and button labels, and reorder items within a container. You can lock elements so clients cannot select or change them, and protect developer access with a PIN.',
      'With Embed code or a custom element, any change means editing code.',
    ],
  },
  {
    id: 'faq-editors',
    q: 'Does it work in Wix Studio, Wix Harmony and Wix Studio Two?',
    a: [
      'Code Canvas supports the Wix Editor (Classic) and Wix Studio. Wix Harmony and Wix Studio Two are not supported yet.',
      `Wix's own Embed code element is available in all four editors, including ${ext(WIX.harmonyEmbed, 'Wix Harmony')} and ${ext(WIX.studioTwoEmbed, 'Wix Studio Two')}.`,
    ],
  },
  {
    id: 'faq-search',
    q: 'Will search engines index my section?',
    a: [
      `We have not tested how search engines index content inside the Code Canvas widget. For headings and text that matter for search, use native Wix text elements, and use a native Wix heading for the page's H1. ${ext(WIX.headings, 'Wix describes the H1')} as the headline of the page, which is also why Code Canvas turns a pasted H1 into an H2.`,
    ],
  },
  {
    id: 'faq-price',
    q: 'How much does Code Canvas cost?',
    a: [
      `There is a Free plan with developer editing and one published design per site. Pro adds unlimited published designs, Client mode, version restore, CMS card lists with search, filters and paging, and Velo site code control. See the ${ext(MARKET, 'App Market listing')} for the current price.`,
    ],
  },
];

const toPlain = (html: string) =>
  html
    .replace(/<span class="visually-hidden">.*?<\/span>/g, '')
    .replace(/<[^>]+>/g, '')
    .replace(/\s+/g, ' ')
    .trim();

const site = Astro.site;
const canonical = site ? new URL(Astro.url.pathname, site).href : undefined;

const TOC = [
  { href: '#compare', label: 'The options at a glance' },
  { href: '#embed', label: 'Embed code (HTML iframe)' },
  { href: '#custom-element', label: 'Custom element' },
  { href: '#studio-css', label: 'Custom CSS in Wix Studio' },
  { href: '#custom-code', label: 'Custom code in site settings' },
  { href: '#code-canvas', label: 'Code Canvas (our app)' },
  { href: '#which', label: 'Which one should you use?' },
  { href: '#steps', label: 'Step by step with Code Canvas' },
  { href: '#faq', label: 'Frequently asked questions' },
  { href: '#sources', label: 'Sources' },
];

/** The comparison table. Cells are plain text; the sections below the table link each Wix source. */
const COLUMNS = ['How your code is shown', 'Editing it later', 'Phones and tablets', 'JavaScript and forms', 'What you need'];
const ROWS: { name: string; href: string; ours?: boolean; cells: string[] }[] = [
  {
    name: 'Embed code (HTML iframe)',
    href: '#embed',
    cells: [
      'Inside a sandboxed iframe, a separate frame in your page',
      'Edit the code in the element',
      "For the Wix Editor, Wix says embeds won't be responsive, even if the code is. Content larger than the frame gets cut off.",
      "Scripts and form submission are allowed inside the frame. It can't reach the rest of the page.",
      "Wix's guides list no plan requirement. Available in the Wix Editor, Wix Studio, Wix Harmony and Wix Studio Two.",
    ],
  },
  {
    name: 'Custom element',
    href: '#custom-element',
    cells: [
      'Your own HTML tag, defined in a JavaScript file and rendered in the page',
      'Edit the JavaScript file',
      'Up to your code',
      'Needs JavaScript: that is how the element works',
      'A paid site plan, a connected domain and no Wix ads. Wix Editor and Wix Studio.',
    ],
  },
  {
    name: 'Custom CSS (Wix Studio)',
    href: '#studio-css',
    cells: [
      "CSS in global.css styles Wix elements. It doesn't add your HTML.",
      'Elements stay editable in the Studio Editor. The CSS is edited as code.',
      'Write media queries in your CSS',
      'CSS only',
      "Wix Studio only. The Wix Editor doesn't give access to CSS.",
    ],
  },
  {
    name: 'Custom code in site settings',
    href: '#custom-code',
    cells: [
      'Snippets in the head or body of your pages, invisible to visitors',
      'In the dashboard: Settings, then Custom Code',
      'Not visible content',
      'For scripts a service gives you, such as a site verification tag',
      'A published site with a connected domain',
    ],
  },
  {
    name: 'Code Canvas (our app)',
    href: '#code-canvas',
    ours: true,
    cells: [
      'In the page at full width, inside a custom element with Shadow DOM. No iframe.',
      'A visual editor for text, links, images and styles. With Pro, clients can edit content.',
      'Styles per screen: Desktop, Tablet (up to 1024 px) and Mobile (up to 480 px)',
      'Scripts are removed. Pasted forms are disabled.',
      'Wix Editor (Classic) or Wix Studio. Free plan: one published design per site. Pro for more.',
    ],
  },
];
---

<BaseLayout title={page.title} description={page.description} ogType="article">
{
  site && canonical && (
    <script
      type="application/ld+json"
      slot="head"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@graph': [
          {
            '@type': 'Article',
            '@id': `${canonical}#article`,
            headline: HEADLINE,
            description: page.description,
            inLanguage: 'en',
            datePublished: CHECKED.iso,
            dateModified: CHECKED.iso,
            mainEntityOfPage: canonical,
            image: new URL('/og-image.png', site).href,
            author: { '@type': 'Organization', '@id': new URL('/#organization', site).href, name: SITE.name, url: site.href },
            publisher: {
              '@type': 'Organization',
              '@id': new URL('/#organization', site).href,
              name: SITE.name,
              url: site.href,
              logo: { '@type': 'ImageObject', url: new URL('/icon-512.png', site).href },
            },
          },
          {
            '@type': 'FAQPage',
            '@id': `${canonical}#faq`,
            mainEntity: FAQ.map((f) => ({
              '@type': 'Question',
              name: f.q,
              acceptedAnswer: { '@type': 'Answer', text: f.a.map(toPlain).join(' ') },
            })),
          },
        ],
      })}
    />
  )
}

<article class="guide">
  <header class="wrap head">
    <div class="eyebrow">Guide · HTML and CSS on Wix</div>
    <h1>{HEADLINE}</h1>
    <div class="lede">
      <p>You have a section in HTML and CSS. Claude or ChatGPT wrote it, a designer sent it, or it comes from an old site. Now you want it on your Wix site, and you want to change the words and pictures later without digging back into code.</p>
      <p>Wix offers several ways to add code, and they behave very differently. Below we compare them, say when each one fits, and walk through the route we built for sections you want to keep editing.</p>
    </div>
    <p class="meta">Wix details checked against Wix's Help Center and developer docs in <time datetime={CHECKED.iso}>{CHECKED.label}</time>.</p>
  </header>

  <div class="wrap">
    <div class="intro">
      <aside class="disclosure" aria-label="Disclosure">
        <p><strong>Disclosure:</strong> we are {SITE.name}, and we make Code Canvas, one of the options in this guide. We cover Wix's own options first and say plainly when our app is the wrong choice.</p>
      </aside>

      <section class="short" aria-labelledby="short-answer">
        <h2 id="short-answer">The short answer</h2>
        <ul>
          <li><strong>Code that needs JavaScript</strong>, such as a calculator, a chart or a widget from another service: use Wix's Embed code element. It runs your code in an iframe.</li>
          <li><strong>Extra styling for Wix elements in Wix Studio</strong>: write CSS in global.css.</li>
          <li><strong>A developer-built component with its own HTML tag</strong>: use a custom element. It needs a paid site plan and a connected domain.</li>
          <li><strong>A static HTML and CSS section you want to keep editing visually</strong>: use an app such as Code Canvas, which we make.</li>
        </ul>
      </section>

      <nav class="toc" aria-labelledby="toc-title">
        <h2 id="toc-title" class="toc-title">On this page</h2>
        <ol>
          {TOC.map((t) => <li><a href={t.href}>{t.label}</a></li>)}
        </ol>
      </nav>
    </div>
  </div>

  <section id="compare" class="wrap block" aria-labelledby="compare-title">
    <div class="prose">
      <h2 id="compare-title">The options at a glance</h2>
      <p>Four of these are built into Wix. The last row is our app, Code Canvas.</p>
    </div>
    <table class="cmp" role="table">
      <caption class="visually-hidden">Ways to add your own HTML and CSS to a Wix site, compared</caption>
      <thead role="rowgroup">
        <tr role="row">
          <th scope="col" role="columnheader">Option</th>
          {COLUMNS.map((c) => <th scope="col" role="columnheader">{c}</th>)}
        </tr>
      </thead>
      <tbody role="rowgroup">
        {
          ROWS.map((r) => (
            <tr role="row" class={r.ours ? 'ours' : undefined}>
              <th scope="row" role="rowheader"><a href={r.href}>{r.name}</a></th>
              {r.cells.map((cell, i) => (
                <td role="cell" data-label={COLUMNS[i]}>{cell}</td>
              ))}
            </tr>
          ))
        }
      </tbody>
    </table>
    <p class="note">Moving a whole website rather than one section? See <a href="#faq-upload">Can I upload an HTML file to Wix?</a></p>
  </section>

  <section id="embed" class="wrap block" aria-labelledby="embed-title">
    <div class="prose">
      <h2 id="embed-title">Embed code (HTML iframe)</h2>
      <p>This is Wix's built-in way to put code on a page. In the Wix Editor, open <b>Add Elements → Embed Code → Popular Embeds → Embed HTML</b>, click <b>Enter Code</b> and paste your code. In Wix Studio, the path is <b>Add Elements → Embed &amp; Social → Embed Code</b>. Wix explains both in its guides for the <a href={WIX.embedEditor} target="_blank" rel="noopener">Wix Editor<span class="visually-hidden"> (opens in a new tab)</span></a> and <a href={WIX.embedStudio} target="_blank" rel="noopener">Wix Studio<span class="visually-hidden"> (opens in a new tab)</span></a>.</p>
      <p>Wix shows that code inside an iframe, a separate frame within your page. Wix's Studio guide calls it a sandboxed iframe and says scripts and form submission are allowed in it, so JavaScript widgets and small tools can run inside it. The code can't reach the other elements on your page, but <a href={WIX.htmlComponent} target="_blank" rel="noopener">Velo page code can send it messages and receive replies<span class="visually-hidden"> (opens in a new tab)</span></a>.</p>
      <h3>Use it for</h3>
      <ul>
        <li>Widgets and embed codes from other services</li>
        <li>Small JavaScript tools, such as a calculator, a chart or a quiz</li>
      </ul>
      <h3>Watch out for</h3>
      <ul>
        <li>In its guide for the Wix Editor, Wix says code in HTML and site embeds won't be responsive, even if it was responsive originally, because these elements are iframes.</li>
        <li>The frame has a fixed size. If the content is larger than the frame, it is cut off and shows scroll bars. For the Wix Editor, Wix suggests <a href={WIX.embedMobile} target="_blank" rel="noopener">hiding the desktop embed on mobile and adding a mobile-friendly one<span class="visually-hidden"> (opens in a new tab)</span></a>.</li>
        <li>Every text change is a code change.</li>
        <li>Only HTTPS code and addresses are displayed.</li>
      </ul>
    </div>
  </section>

  <section id="custom-element" class="wrap block" aria-labelledby="ce-title">
    <div class="prose">
      <h2 id="ce-title">Custom element</h2>
      <p>A custom element is a web component: a JavaScript file that defines your own HTML tag. You add a Custom Element from the Add Elements panel, choose its source (a file on your own server, or a Velo file hosted by Wix) and enter its tag name. See Wix's guides for the <a href={WIX.ceEditor} target="_blank" rel="noopener">Wix Editor<span class="visually-hidden"> (opens in a new tab)</span></a> and <a href={WIX.ceStudio} target="_blank" rel="noopener">Wix Studio<span class="visually-hidden"> (opens in a new tab)</span></a>.</p>
      <p>In the editor and in preview, Wix renders it inside an iframe for security, so check the published site to see how it really looks.</p>
      <h3>Use it for</h3>
      <ul>
        <li>Components that need JavaScript running in the page, for example to change their own height on the live site</li>
        <li>Effects such as CSS animation, tooltips or charts</li>
      </ul>
      <h3>Watch out for</h3>
      <ul>
        <li><a href={WIX.ceVelo} target="_blank" rel="noopener">Wix requires<span class="visually-hidden"> (opens in a new tab)</span></a> a paid site plan, a connected custom domain and no Wix ads to use custom elements on a live site.</li>
        <li>Even plain HTML and CSS has to be wrapped in a script that defines the element.</li>
        <li>Changing the content usually means changing the code, so it rarely suits clients who edit their own text.</li>
      </ul>
    </div>
  </section>

  <section id="studio-css" class="wrap block" aria-labelledby="css-title">
    <div class="prose">
      <h2 id="css-title">Custom CSS in Wix Studio</h2>
      <p>Wix Studio lets you write CSS for the elements you build in the editor. Click the <b>Code</b> icon, click <b>Start Coding</b> the first time, open <b>Page Code</b> and then <b>global.css</b> under CSS. You can style Wix's own classes, such as <code>.button</code>, or create your own classes. <a href={WIX.cssStudio} target="_blank" rel="noopener">Wix's CSS guide<span class="visually-hidden"> (opens in a new tab)</span></a> has the details.</p>
      <p>This styles Wix elements. It doesn't place your HTML on the page. To use an AI-made section this way, you rebuild its structure with Wix elements first, then bring the styling across.</p>
      <h3>Use it for</h3>
      <ul>
        <li>Styling the editor panels don't offer, such as your own animations, media queries or styles for one part of an element, like a button's label</li>
      </ul>
      <h3>Watch out for</h3>
      <ul>
        <li>It is for Wix Studio only. For the Wix Editor, <a href={WIX.cssEditor} target="_blank" rel="noopener">Wix says it is not possible to access your site's CSS<span class="visually-hidden"> (opens in a new tab)</span></a>.</li>
        <li>CSS in global.css overrides settings made in the editor's panels, so tell anyone else who edits the site that it is there.</li>
        <li>Not every element supports CSS classes. Check Wix's list of supported elements first.</li>
      </ul>
    </div>
  </section>

  <section id="custom-code" class="wrap block" aria-labelledby="code-title">
    <div class="prose">
      <h2 id="code-title">Custom code in site settings</h2>
      <p>In your site's dashboard, <b>Settings → Custom Code</b> adds snippets to the head or body of all your pages, or of pages you choose. <a href={WIX.customCode} target="_blank" rel="noopener">Wix says these snippets are always invisible to visitors<span class="visually-hidden"> (opens in a new tab)</span></a>, and its own FAQ points to an HTML iframe for visible code.</p>
      <p>Use it when a service gives you a snippet and tells you where to place it, such as a site verification tag. It needs a published site with a connected domain, and <a href={WIX.planDomain} target="_blank" rel="noopener">connecting a domain needs a paid site plan<span class="visually-hidden"> (opens in a new tab)</span></a>. It won't show an HTML section on a page.</p>
    </div>
  </section>

  <section id="code-canvas" class="wrap block" aria-labelledby="cc-title">
    <div class="prose">
      <h2 id="cc-title">Code Canvas (our app)</h2>
      <p>Code Canvas is our app on the Wix App Market. You paste HTML and CSS into its editor on your Wix dashboard. It imports the code into a visual editor, where you change text, links, images and styles. Then you add the Code Canvas widget to a page and choose your design.</p>
      <p>The widget renders your section full width in the page, inside a custom element with Shadow DOM, not in an iframe. You set styles per screen: Desktop is the base, Tablet applies up to 1024 px wide and Mobile up to 480 px.</p>
      <h3>Use it for</h3>
      <ul>
        <li>Static sections from Claude, ChatGPT, a designer or an old site, such as a hero, a services block or a card grid</li>
        <li>Sections that you or a client will keep editing without touching code</li>
        <li>Client handover. With Pro, Client mode lets clients change content while the parts you lock stay protected.</li>
      </ul>
      <h3>Watch out for</h3>
      <ul>
        <li>Scripts are removed when you import, and pasted forms are disabled.</li>
        <li>A pasted H1 becomes an H2, because the Wix page has its own H1.</li>
        <li>It works on the Wix Editor (Classic) and Wix Studio. Wix Harmony and Wix Studio Two are not supported yet.</li>
        <li>The Free plan includes one published design per site. Pro adds unlimited published designs, Client mode, version restore, CMS card lists with search, filters and paging, and Velo site code control.</li>
      </ul>
    </div>
  </section>

  <section id="which" class="wrap block" aria-labelledby="which-title">
    <div class="prose">
      <h2 id="which-title">Which one should you use?</h2>
      <ul class="choices">
        <li><strong>Your code needs JavaScript</strong>, such as a calculator, chart, map, quiz or booking widget. Use Embed code. If you are a developer with a paid plan and a domain, a custom element also works.</li>
        <li><strong>You build in Wix Studio and want styling the panels don't offer.</strong> Use global.css.</li>
        <li><strong>A service gave you a head or body snippet.</strong> Use Custom Code in your site settings.</li>
        <li><strong>You have a static HTML and CSS section and want to keep editing it.</strong> Code Canvas fits.</li>
        <li><strong>You want to move a whole static site.</strong> <a href={WIX.headlessUpload} target="_blank" rel="noopener">Wix Headless can host HTML, CSS and JavaScript files you upload<span class="visually-hidden"> (opens in a new tab)</span></a>. That creates a separate Headless site, which you update by uploading files again.</li>
      </ul>
      <div class="not-for">
        <h3>Code Canvas is not for you if</h3>
        <ul>
          <li>Your section depends on JavaScript, such as a data visualization, a script-driven slider or an app. The importer removes scripts.</li>
          <li>You need a form that sends submissions. Pasted forms are disabled, so add a Wix Form below the section instead.</li>
          <li>You want to move a whole multi-page site. Code Canvas is built for sections, not site migration.</li>
          <li>You need backend code, or want to embed an external web app.</li>
          <li>Your site is on Wix Harmony or Wix Studio Two. Both editors have their own Embed code element, and Studio Two has a <a href={WIX.studioTwoImport} target="_blank" rel="noopener">beta feature for importing site code<span class="visually-hidden"> (opens in a new tab)</span></a>.</li>
        </ul>
      </div>
    </div>
  </section>

  <section id="steps" class="wrap block" aria-labelledby="steps-title">
    <div class="prose">
      <h2 id="steps-title">Step by step: add an editable section with Code Canvas</h2>
      <p>These steps match our <a href={help('add-html-css')} target="_blank" rel="noopener">help page<span class="visually-hidden"> (opens in a new tab)</span></a> and the current labels in the app. The screenshots come from our own Wix Studio test sites.</p>
    </div>
    <ol class="steps">
      <li>
        <div class="prose">
          <h3>Get your HTML and CSS ready</h3>
          <p>Work on one section at a time, such as a hero, a services block or a card grid. Keep it to HTML and CSS, since scripts are removed and forms are disabled. If an AI tool writes the code, click <b>Copy AI prompt</b> in Code Canvas, or copy the same prompt from <a href={HELP} target="_blank" rel="noopener">our help page<span class="visually-hidden"> (opens in a new tab)</span></a>. It asks for one section of HTML and CSS, with no scripts or forms.</p>
        </div>
      </li>
      <li>
        <div class="prose">
          <h3>Add Code Canvas and start a design</h3>
          <p>Add Code Canvas to your site from the <a href={MARKET} target="_blank" rel="noopener">Wix App Market<span class="visually-hidden"> (opens in a new tab)</span></a>. Then, in your Wix dashboard, open <b>Apps → Code Canvas Editor</b> and click <b>New design</b>.</p>
        </div>
      </li>
      <li>
        <div class="prose">
          <h3>Paste your code and import it</h3>
          <p>Paste your HTML and CSS and click <b>Import</b>. If an import report opens, read it: it lists anything that was removed or changed, such as a script, a form or an H1. Then click <b>Load into canvas</b>.</p>
        </div>
        <figure class="fig fig-wide">
          <div class="frame"><div style="aspect-ratio:1712/724"><ImageSlot id="guide-import-report" /></div></div>
          <figcaption>The import report for a test design: one script removed, a form warning, and an H1 changed to an H2.</figcaption>
        </figure>
      </li>
      <li>
        <div class="prose">
          <h3>Edit it visually and check each screen size</h3>
          <p>Double-click text on the canvas to type. Select a link or button to change its label and URL in the <b>Edit</b> tab, or select an image to replace it and set its alt text. Switch between <b>Desktop 1200</b>, <b>Tablet 768</b> and <b>Mobile 375</b> to check the layout. In the <b>Style</b> tab, Desktop is the base, Tablet changes apply up to 1024 px wide and Mobile changes up to 480 px.</p>
        </div>
        <figure class="fig fig-wide">
          <div class="frame"><div style="aspect-ratio:1984/680"><ImageSlot id="guide-tablet-styles" /></div></div>
          <figcaption>The Style panel says which screens a change affects. Here, Tablet and smaller, up to 1024 px wide.</figcaption>
        </figure>
      </li>
      <li>
        <div class="prose">
          <h3>Publish the design</h3>
          <p>Give the design a clear name and click <b>Publish changes</b>. <b>Save Draft</b> keeps your work without making it live. The Free plan includes one published design per site.</p>
        </div>
      </li>
      <li>
        <div class="prose">
          <h3>Add the widget to your page</h3>
          <p>In the Wix editor, open the page and go to <b>Add Elements → App Widgets</b>, then add <b>Code Canvas</b>. Select the widget, open <b>Settings</b> and choose your design under <b>Design</b>. If the list looks out of date, click <b>Refresh list</b>.</p>
        </div>
        <figure class="fig fig-wide">
          <div class="frame"><div style="aspect-ratio:2060/862"><ImageSlot id="guide-widget-settings" /></div></div>
          <figcaption>Choose the design in the widget's Settings panel.</figcaption>
        </figure>
      </li>
      <li>
        <div class="prose">
          <h3>Publish the site and check the live page</h3>
          <p>Click <b>Publish</b> in Wix and open the live page. Check it on a phone as well.</p>
        </div>
        <figure class="fig">
          <div class="frame"><div style="aspect-ratio:4/3"><ImageSlot id="guide-live" /></div></div>
          <figcaption>A test section on a published Wix site, on a desktop and on a phone.</figcaption>
        </figure>
      </li>
      <li>
        <div class="prose">
          <h3>Make changes later</h3>
          <p>Edit the design in Code Canvas and click <b>Publish changes</b>. Pages that already show it update, but live sites can take up to a minute, so refresh after a moment. You only need Wix <b>Publish</b> again for a new widget, or when a widget switches to another design.</p>
          <p>To work in code, click <b>Edit code</b>. It shows the current code, and <b>Apply code</b> updates the canvas. <b>Paste new code instead</b> starts again from a fresh paste and replaces what is on the canvas, so save a draft first. With Pro, you can also restore an earlier saved version.</p>
        </div>
      </li>
      <li>
        <div class="prose">
          <h3>Hand it over to a client (Pro)</h3>
          <p>With Pro, turn on Client mode and choose <b>Content only</b>. Tick <b>Lock for client</b> on anything you want to protect. Clients can then change text, images, links and button labels, and reorder items within a container, while locked elements and the layout stay as you built them.</p>
        </div>
        <figure class="fig">
          <div class="frame"><div style="aspect-ratio:4/3"><ImageSlot id="guide-client" /></div></div>
          <figcaption>The developer locks an element, and the client edits only content.</figcaption>
        </figure>
      </li>
    </ol>
    <p class="note">More help: <a href={help('place-widget')} target="_blank" rel="noopener">place the widget<span class="visually-hidden"> (opens in a new tab)</span></a>, <a href={help('edit-content')} target="_blank" rel="noopener">edit text and links<span class="visually-hidden"> (opens in a new tab)</span></a>, <a href={help('responsive-layout')} target="_blank" rel="noopener">fix the mobile layout<span class="visually-hidden"> (opens in a new tab)</span></a> and <a href={help('troubleshoot-missing-section')} target="_blank" rel="noopener">find a missing section<span class="visually-hidden"> (opens in a new tab)</span></a>.</p>
  </section>

  <section id="faq" class="wrap block" aria-labelledby="faq-title">
    <div class="prose">
      <h2 id="faq-title">Frequently asked questions</h2>
      <div class="faq">
        {
          FAQ.map((f) => (
            <div class="faq-item" id={f.id}>
              <h3>{f.q}</h3>
              {f.a.map((p) => <p set:html={p} />)}
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section id="sources" class="wrap block" aria-labelledby="sources-title">
    <div class="prose">
      <h2 id="sources-title">Sources</h2>
      <p>We checked the Wix details in this guide against these Wix pages in {CHECKED.label}. Wix changes its editors often, so check them again before you rely on a detail.</p>
      <ul class="sources">
        {SOURCES.map((s) => <li><a href={s.href} target="_blank" rel="noopener">{s.title}<span class="visually-hidden"> (opens in a new tab)</span></a></li>)}
      </ul>
      <p>The Code Canvas details come from its <a href={MARKET} target="_blank" rel="noopener">App Market listing<span class="visually-hidden"> (opens in a new tab)</span></a> and <a href={HELP} target="_blank" rel="noopener">help pages<span class="visually-hidden"> (opens in a new tab)</span></a>.</p>
    </div>
  </section>
</article>

<section class="app-surface cta" data-surface="dark" aria-labelledby="cta-title">
  <div class="wrap cta-inner">
    <div class="cta-eyebrow">Code Canvas · For Wix Studio and the Wix Classic Editor</div>
    <h2 id="cta-title">Have a section that fits? Try it in Code Canvas.</h2>
    <p>Free plan: one published design per site. Pro for more. Code Canvas is an independent app by {SITE.name}.</p>
    <div class="cta-links">
      <a class="hv-app-primary cta-primary" href={MARKET} target="_blank" rel="noopener">Get it on the Wix App Market ↗<span class="visually-hidden"> (opens in a new tab)</span></a>
      <a class="hv-accent cta-secondary" href={HELP} target="_blank" rel="noopener">Help and setup guide ↗<span class="visually-hidden"> (opens in a new tab)</span></a>
    </div>
  </div>
</section>
</BaseLayout>

