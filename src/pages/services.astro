---
import BaseLayout from '../layouts/BaseLayout.astro';
import { PAGES } from '../data/site';
---

<BaseLayout title={PAGES.services.title} description={PAGES.services.description}>
<section style="max-width:1360px;margin:0 auto;padding-left:clamp(20px,4vw,48px);padding-right:clamp(20px,4vw,48px);padding-top:clamp(40px,6vw,88px);padding-bottom:clamp(40px,5vw,64px);display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,420px),1fr));gap:28px clamp(40px,6vw,96px);align-items:end">
  <div style="display:flex;flex-direction:column;gap:20px">
    <div style="font-size:12px;letter-spacing:0.16em;text-transform:uppercase;color:#355C63;font-weight:500">Services</div>
    <h1 style="margin:0;font-family:'Cormorant Garamond',serif;font-weight:400;font-size:clamp(46px,6vw,88px);line-height:0.98;letter-spacing:-0.015em;text-wrap:balance">Websites first. Marketing when you need it.</h1>
  </div>
  <div style="display:flex;flex-direction:column;gap:22px;align-items:flex-start">
    <p style="margin:0;font-size:16px;line-height:1.6;max-width:440px">From first structure to final launch, we handle the website from start to finish.</p>
    <a class="hv-b9b180" href="/contact/" style="background:#355C63;color:#F7F4EF;padding:15px 26px;font-size:14px;font-weight:500;white-space:nowrap">Start Your Project</a>
  </div>
</section>
<section style="max-width:1360px;margin:0 auto;padding-left:clamp(20px,4vw,48px);padding-right:clamp(20px,4vw,48px);padding-bottom:clamp(80px,10vw,128px)">
  <div data-reveal class="svc-row" style="display:grid;grid-template-columns:48px minmax(0,1fr) minmax(0,1.3fr) 120px;gap:10px 28px;padding:30px 0;border-top:1px solid #D7D3CF;align-items:baseline">
    <span style="font-size:12px;color:#355C63">01</span>
    <h2 style="margin:0;font-family:'Cormorant Garamond',serif;font-weight:400;font-size:clamp(26px,2.6vw,36px);line-height:1.05">Website Strategy</h2>
    <p style="margin:0;font-size:15px;line-height:1.65">We define the structure, pages, user journey and content hierarchy before development.</p>
    <span style="font-size:12px;letter-spacing:0.1em;text-transform:uppercase;color:#355C63;text-align:right">Shrey</span>
  </div>
  <div data-reveal class="svc-row" style="display:grid;grid-template-columns:48px minmax(0,1fr) minmax(0,1.3fr) 120px;gap:10px 28px;padding:30px 0;border-top:1px solid #D7D3CF;align-items:baseline">
    <span style="font-size:12px;color:#355C63">02</span>
    <h2 style="margin:0;font-family:'Cormorant Garamond',serif;font-weight:400;font-size:clamp(26px,2.6vw,36px);line-height:1.05">UX &amp; Website Design</h2>
    <p style="margin:0;font-size:15px;line-height:1.65">Clear, responsive interfaces designed around how people actually use the website.</p>
    <span style="font-size:12px;letter-spacing:0.1em;text-transform:uppercase;color:#355C63;text-align:right">Shrey</span>
  </div>
  <div data-reveal class="svc-row" style="display:grid;grid-template-columns:48px minmax(0,1fr) minmax(0,1.3fr) 120px;gap:10px 28px;padding:30px 0;border-top:1px solid #D7D3CF;align-items:baseline">
    <span style="font-size:12px;color:#355C63">03</span>
    <h2 style="margin:0;font-family:'Cormorant Garamond',serif;font-weight:400;font-size:clamp(26px,2.6vw,36px);line-height:1.05">Website Development</h2>
    <p style="margin:0;font-size:15px;line-height:1.65">Built on the platform that fits the project, from Wix and WordPress to custom HTML, CSS and JavaScript.</p>
    <span style="font-size:12px;letter-spacing:0.1em;text-transform:uppercase;color:#355C63;text-align:right">Shrey</span>
  </div>
  <div data-reveal class="svc-row" style="display:grid;grid-template-columns:48px minmax(0,1fr) minmax(0,1.3fr) 120px;gap:10px 28px;padding:30px 0;border-top:1px solid #D7D3CF;align-items:baseline">
    <span style="font-size:12px;color:#355C63">04</span>
    <h2 style="margin:0;font-family:'Cormorant Garamond',serif;font-weight:400;font-size:clamp(26px,2.6vw,36px);line-height:1.05">CMS &amp; Custom Functionality</h2>
    <p style="margin:0;font-size:15px;line-height:1.65">CMS structures, dynamic content, backend functionality and integrations for projects that need more than standard pages.</p>
    <span style="font-size:12px;letter-spacing:0.1em;text-transform:uppercase;color:#355C63;text-align:right">Shrey</span>
  </div>
  <div data-reveal class="svc-row" style="display:grid;grid-template-columns:48px minmax(0,1fr) minmax(0,1.3fr) 120px;gap:10px 28px;padding:30px 0;border-top:1px solid #2F2F2F;border-bottom:1px solid #D7D3CF;align-items:baseline">
    <span style="font-size:12px;color:#7A5C49">05</span>
    <h2 style="margin:0;font-family:'Cormorant Garamond',serif;font-weight:400;font-size:clamp(26px,2.6vw,36px);line-height:1.05">Digital Marketing</h2>
    <p style="margin:0;font-size:15px;line-height:1.65">Strategy, positioning, content direction and ongoing marketing, alongside your website project or as a separate engagement.</p>
    <span style="font-size:12px;letter-spacing:0.1em;text-transform:uppercase;color:#7A5C49;text-align:right">Kenny</span>
  </div>
</section>
<section data-surface="dark" style="background:#355C63;color:#F7F4EF">
  <div style="max-width:1360px;margin:0 auto;padding-left:clamp(20px,4vw,48px);padding-right:clamp(20px,4vw,48px);padding-top:clamp(80px,10vw,128px);padding-bottom:clamp(80px,10vw,128px)">
    <div data-reveal style="display:flex;flex-direction:column;gap:14px;margin-bottom:clamp(40px,5vw,56px)">
      <div style="font-size:12px;letter-spacing:0.16em;text-transform:uppercase;color:#D9C7B8;font-weight:500">Ways to work with us</div>
      <h2 style="margin:0;font-family:'Cormorant Garamond',serif;font-weight:400;font-size:clamp(36px,4.4vw,60px);line-height:1">Pick the path that fits.</h2>
    </div>
    <div data-reveal style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,280px),1fr));gap:20px">
      <a class="hv-285c08" href="/contact/?need=New%20Website" style="display:flex;flex-direction:column;gap:14px;padding:32px;background:#F7F4EF;color:#2F2F2F">
        <span style="font-size:12px;letter-spacing:0.14em;text-transform:uppercase;color:#355C63">Most common</span>
        <span style="font-family:'Cormorant Garamond',serif;font-size:34px;line-height:1">Website Project</span>
        <span style="font-size:14px;line-height:1.65">A complete website build or redesign.</span>
        <span style="margin-top:auto;padding-top:20px;font-size:14px;font-weight:500">Build My Website →</span>
      </a>
      <a class="hv-f04467" href="/contact/?need=Website%20%2B%20Marketing" style="display:flex;flex-direction:column;gap:14px;padding:32px;border:1px solid rgba(247,244,239,0.4);color:#F7F4EF">
        <span style="font-size:12px;letter-spacing:0.14em;text-transform:uppercase;color:#D9C7B8">Combined</span>
        <span style="font-family:'Cormorant Garamond',serif;font-size:34px;line-height:1">Website + Marketing</span>
        <span style="font-size:14px;line-height:1.65">Build the website first, then bring the right people to it.</span>
        <span style="margin-top:auto;padding-top:20px;font-size:14px;font-weight:500">Start Your Project →</span>
      </a>
      <a class="hv-f04467" href="/contact/?need=Digital%20Marketing" style="display:flex;flex-direction:column;gap:14px;padding:32px;border:1px solid rgba(247,244,239,0.4);color:#F7F4EF">
        <span style="font-size:12px;letter-spacing:0.14em;text-transform:uppercase;color:#D9C7B8">Standalone</span>
        <span style="font-family:'Cormorant Garamond',serif;font-size:34px;line-height:1">Marketing Project</span>
        <span style="font-size:14px;line-height:1.65">A separate marketing and strategy engagement.</span>
        <span style="margin-top:auto;padding-top:20px;font-size:14px;font-weight:500">Discuss Marketing →</span>
      </a>
    </div>
  </div>
</section>
<section data-surface="dark" style="background:#2F2F2F;color:#F7F4EF">
  <div data-reveal style="max-width:1360px;margin:0 auto;padding:clamp(88px,11vw,150px) clamp(20px,4vw,48px);display:flex;flex-direction:column;gap:28px;align-items:flex-start">
    <h2 style="margin:0;font-family:'Cormorant Garamond',serif;font-weight:400;font-size:clamp(48px,7vw,104px);line-height:0.98;letter-spacing:-0.01em">Ready to build?</h2>
    <p style="margin:0;font-size:17px;line-height:1.6;max-width:520px;color:#D7D3CF">Tell us what you're working on, what you need and when you'd like to launch.</p>
    <a class="hv-d0dd51" href="/contact/" style="margin-top:8px;background:#F7F4EF;color:#2F2F2F;padding:17px 30px;font-size:15px;font-weight:500;white-space:nowrap">Start Your Project</a>
  </div>
</section>

</BaseLayout>
