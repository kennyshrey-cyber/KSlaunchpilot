---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactForm from '../../components/ContactForm.astro';
import { PAGES } from '../../data/site';
---

<BaseLayout title={PAGES.contact.title} description={PAGES.contact.description} stickyCta={false}>
<section style="max-width:1360px;margin:0 auto;padding-left:clamp(20px,4vw,48px);padding-right:clamp(20px,4vw,48px);padding-top:clamp(40px,6vw,80px);padding-bottom:clamp(80px,10vw,128px);display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,340px),1fr));gap:48px clamp(40px,6vw,96px);align-items:start">
  <div style="display:flex;flex-direction:column;gap:22px">
    <div style="font-size:12px;letter-spacing:0.16em;text-transform:uppercase;color:#355C63;font-weight:500">Contact</div>
    <h1 style="margin:0;font-family:'Cormorant Garamond',serif;font-weight:400;font-size:clamp(46px,6vw,88px);line-height:0.98;letter-spacing:-0.015em;text-wrap:balance">Start your project.</h1>
    <p style="margin:0;font-size:16px;line-height:1.65;max-width:420px">Tell us what you need and when you'd like to launch. We'll reply to arrange a short call.</p>
    <div style="display:flex;flex-direction:column;gap:6px;padding-top:22px;border-top:1px solid #D7D3CF;font-size:14px">
      <span style="color:#5A6851">Prefer email?</span>
      <a class="hv-728b35" href="mailto:hello@kslaunchpilot.com" style="font-size:16px;color:#2F2F2F">hello@kslaunchpilot.com</a>
    </div>
  </div>
  <div class="contact-form-col" style="min-width:0">
    <ContactForm />
  </div>
</section>
</BaseLayout>
