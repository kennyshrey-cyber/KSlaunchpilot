---
import BaseLayout from '../layouts/BaseLayout.astro';
import ImageSlot from '../components/ImageSlot.astro';
import AppsShowcase from '../components/AppsShowcase.astro';
import { PAGES, SITE, SOCIALS } from '../data/site';
import { FEATURED } from '../data/projects';
import { hasImage } from '../data/images';
import { IS_LAUNCH } from '../data/edition';

const TEAM = [
  { name: 'Shrey', imageId: 'lp-shrey', role: 'Website design, development and technical implementation.' },
  { name: 'Kenny', imageId: 'lp-kenny', role: 'Digital marketing and strategy.' },
];
/* Team photos are optional: with no photo registered, the rows are text only (no empty photo boxes). */
const teamPhotos = TEAM.every((m) => hasImage(m.imageId));

/* "What we can build": one illustrative design per type of site. Not client projects. */
const BUILD_TYPES = [
  { title: 'Business Websites', imageId: 'lp-l-business', text: 'Launch-ready sites for startups and established companies.' },
  { title: 'Hospitality & Airbnb', imageId: 'lp-l-resort', text: 'Hotels, resorts and Airbnb portfolios with direct booking and channel manager integration.' },
  { title: 'Wellness & Lifestyle', imageId: 'lp-l-wellness', text: 'Studios, retreats and lifestyle brands with schedules and bookings.' },
  { title: 'Professional Services', imageId: 'lp-l-professional', text: 'Consultancies, clinics and firms that need to look credible fast.' },
  { title: 'Real Estate', imageId: 'lp-l-realty', text: 'Property listings with search, filters and enquiry forms.' },
  { title: 'Custom CMS & Dynamic Sites', imageId: 'lp-l-cs-search', text: 'Directories, member areas and content your team can manage.' },
];
---

<BaseLayout title={PAGES.home.title} description={PAGES.home.description}>
{
  Astro.site && (
    <script
      type="application/ld+json"
      slot="head"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@graph': [
          {
            '@type': 'ProfessionalService',
            '@id': new URL('/#organization', Astro.site).href,
            name: SITE.name,
            description: PAGES.home.description,
            url: Astro.site.href,
            email: SITE.email,
            logo: new URL('/icon-512.png', Astro.site).href,
            image: new URL('/og-image.png', Astro.site).href,
            address: { '@type': 'PostalAddress', addressLocality: SITE.locality, addressRegion: SITE.region, addressCountry: SITE.country },
            areaServed: SITE.areaServed.map((name) => ({ '@type': 'Place', name })),
            knowsAbout: [
              'Wix web design',
              'Wix development',
              'Wix Velo',
              'Wix apps',
              'WordPress development',
              'Wix Studio Two',
              'Squarespace',
              'GoHighLevel websites and funnels',
              'React',
              'Next.js',
              'Figma',
              'Search engine optimisation (SEO)',
              'Wix SEO',
              'WordPress SEO',
              'Digital marketing',
              'Conversion rate optimisation',
              'E-commerce websites',
              'Small business websites',
              'Airbnb direct booking websites',
              'Booking channel manager integration',
            ],
            hasOfferCatalog: {
              '@type': 'OfferCatalog',
              name: 'Services',
              itemListElement: [
                'Wix website design and development',
                'WordPress website design and development',
                'Custom website development in React and Next.js',
                'Wix Studio Two, Squarespace and GoHighLevel websites',
                'GoHighLevel funnels',
                'SEO for Wix and WordPress websites',
                'Digital marketing for small businesses and e-commerce',
                'Conversion rate optimisation',
                'CMS and custom functionality',
                'Wix app development',
                'Airbnb and vacation rental direct booking websites with channel manager integration',
              ].map((name) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name } })),
            },
            sameAs: SOCIALS.map((x) => x.href),
          },
          {
            '@type': 'WebSite',
            '@id': new URL('/#website', Astro.site).href,
            name: SITE.name,
            url: Astro.site.href,
            inLanguage: 'en',
            publisher: { '@id': new URL('/#organization', Astro.site).href },
          },
        ],
      })}
    />
  )
}
<section style="max-width:1360px;margin:0 auto;padding:clamp(40px,6vw,88px) clamp(20px,4vw,48px) clamp(64px,8vw,112px)">
  <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,440px),1fr));gap:56px clamp(40px,5vw,80px);align-items:center">
    <div style="display:flex;flex-direction:column;gap:26px">
      <a class="hv-announce" href="#apps" style="align-self:flex-start;display:inline-flex;align-items:center;gap:10px;border:1px solid #B7A89B;padding:8px 14px;font-size:13px;line-height:1.3;color:#2F2F2F"><span style="background:#151C32;color:#FFFFFF;font-size:11px;letter-spacing:0.1em;text-transform:uppercase;font-weight:500;padding:3px 8px">New</span>Code Canvas and CollectionGrid are live on the Wix App Market <span aria-hidden="true">→</span></a>
      <div style="font-size:12px;letter-spacing:0.16em;text-transform:uppercase;color:#355C63;font-weight:500">React · Next.js · Wix Studio Two · WordPress · Squarespace · GoHighLevel</div>
      <h1 style="margin:0;font-family:'Cormorant Garamond',serif;font-weight:400;font-size:clamp(52px,7vw,104px);line-height:0.96;letter-spacing:-0.015em;text-wrap:balance">Websites that convert, on any platform.</h1>
      <p style="margin:0;font-size:clamp(16px,1.3vw,18px);line-height:1.6;max-width:520px">KS LaunchPilot is a two-person studio in Manila. We design in Figma and build custom websites in React and Next.js, or on Wix, Wix Studio Two, WordPress, Squarespace and GoHighLevel, then grow them with SEO and digital marketing for small businesses and e-commerce brands across Southeast Asia and the US.</p>
      <div style="display:flex;gap:14px 28px;align-items:center;flex-wrap:wrap;margin-top:4px">
        <a class="hv-b9b180" href="/contact/" style="background:#355C63;color:#F7F4EF;padding:17px 30px;font-size:15px;font-weight:500;white-space:nowrap">Start Your Project</a>
        <a class="hv-87875d" href="#services" style="font-size:15px;border-bottom:1px solid #2F2F2F;padding-bottom:3px;color:#2F2F2F;white-space:nowrap">See What We Do</a>
      </div>
    </div>

    <div aria-hidden="true" style="position:relative;padding:6% 0 10% 8%;width:100%;max-width:560px;margin:0 auto">
      <div style="background:#FFFFFF;border:1px solid #D7D3CF;box-shadow:0 40px 80px -40px rgba(47,47,47,0.35);display:flex;flex-direction:column;overflow:hidden">
        <div style="display:flex;align-items:center;gap:12px;padding:9px 12px;border-bottom:1px solid #D7D3CF;background:#F7F4EF">
          <div style="display:flex;gap:5px"><span style="width:8px;height:8px;border-radius:50%;background:#D7D3CF"></span><span style="width:8px;height:8px;border-radius:50%;background:#D7D3CF"></span><span style="width:8px;height:8px;border-radius:50%;background:#D7D3CF"></span></div>
          <div style="flex:1;background:#FFFFFF;border:1px solid #D7D3CF;padding:4px 10px;font-size:10px;color:#7A5C49;letter-spacing:0.02em">yourbusiness.com</div>
        </div>
        <div style="aspect-ratio:4/3"><ImageSlot id="lp-l-hero-desktop" loading="eager" decorative /></div>
      </div>

      <div class="hero-cms" data-surface="dark" style="position:absolute;left:0;bottom:4%;width:40%;background:#2F2F2F;color:#F7F4EF;padding:14px 16px;display:flex;flex-direction:column;gap:10px;box-shadow:0 24px 48px -20px rgba(47,47,47,0.5);font-size:10px">
        <div style="display:flex;justify-content:space-between;gap:10px;letter-spacing:0.12em;text-transform:uppercase;color:#D9C7B8;white-space:nowrap"><span>CMS · Collection</span><span>3 items</span></div>
        <div style="display:flex;justify-content:space-between;padding-top:8px;border-top:1px solid rgba(247,244,239,0.2)"><span>Service page</span><span style="color:#D9C7B8">Published</span></div>
        <div style="display:flex;justify-content:space-between;padding-top:8px;border-top:1px solid rgba(247,244,239,0.2)"><span>Booking form</span><span style="color:#D9C7B8">Connected</span></div>
        <div style="display:flex;justify-content:space-between;padding-top:8px;border-top:1px solid rgba(247,244,239,0.2)"><span>Team profiles</span><span style="color:#B7A89B">Draft</span></div>
      </div>

      <div data-surface="dark" style="position:absolute;right:-2%;bottom:0;width:24%;aspect-ratio:9/18.5;background:#2F2F2F;padding:5px;border-radius:18px;box-shadow:0 24px 48px -20px rgba(47,47,47,0.5)">
        <div style="width:100%;height:100%;border-radius:13px;overflow:hidden;background:#FFFFFF"><ImageSlot id="lp-l-hero-phone" loading="eager" decorative /></div>
      </div>
    </div>
  </div>
</section>

<section data-surface="dark" style="background:#2F2F2F;color:#F7F4EF">
  <div style="max-width:1360px;margin:0 auto;padding:clamp(72px,9vw,120px) clamp(20px,4vw,48px);display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,380px),1fr));gap:48px clamp(40px,6vw,96px);align-items:start">
    <div data-reveal style="display:flex;flex-direction:column;gap:20px">
      <div style="font-size:12px;letter-spacing:0.16em;text-transform:uppercase;color:#D9C7B8;font-weight:500">The studio</div>
      <h2 style="margin:0;font-family:'Cormorant Garamond',serif;font-weight:400;font-size:clamp(40px,5vw,68px);line-height:1;text-wrap:balance">Web design and digital marketing. One direct team.</h2>
      <p style="margin:0;font-size:16px;line-height:1.65;max-width:440px;color:#D7D3CF">You work directly with the people doing the work. No account managers, no hand-offs.</p>
      <a class="hv-bae33e" href="/about/" style="align-self:flex-start;font-size:14px;color:#F7F4EF;border-bottom:1px solid #F7F4EF;padding-bottom:3px;white-space:nowrap">Meet the team →</a>
    </div>
    <div data-reveal style="display:flex;flex-direction:column">
      {
        TEAM.map((m, i) => (
          <div style={`display:grid;grid-template-columns:${teamPhotos ? '88px minmax(0,1fr)' : 'minmax(0,1fr)'};gap:22px;padding:24px 0;border-top:1px solid rgba(247,244,239,0.25);${i === TEAM.length - 1 ? 'border-bottom:1px solid rgba(247,244,239,0.25);' : ''}align-items:center`}>
            {teamPhotos && <div style="aspect-ratio:1/1"><ImageSlot id={m.imageId} /></div>}
            <div style="display:flex;flex-direction:column;gap:6px">
              <span style="font-family:'Cormorant Garamond',serif;font-size:30px;line-height:1">{m.name}</span>
              <span style="font-size:14px;line-height:1.55;color:#D7D3CF">{m.role}</span>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<section id="services" style="max-width:1360px;margin:0 auto;padding:clamp(80px,10vw,128px) clamp(20px,4vw,48px);scroll-margin-top:70px">
  <div data-reveal style="display:flex;flex-direction:column;gap:14px;margin-bottom:clamp(36px,4vw,56px)">
    <div style="font-size:12px;letter-spacing:0.16em;text-transform:uppercase;color:#355C63;font-weight:500">How we can help</div>
    <h2 style="margin:0;font-family:'Cormorant Garamond',serif;font-weight:400;font-size:clamp(38px,4.6vw,64px);line-height:1">Two ways to work with us</h2>
  </div>
  <div style="display:flex;flex-wrap:wrap;gap:20px">
    <article data-surface="dark" data-reveal style="flex:1.6 1 540px;min-width:0;background:#355C63;color:#F7F4EF;padding:clamp(28px,4vw,56px);display:flex;flex-direction:column;gap:22px">
      <div style="display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;font-size:12px;letter-spacing:0.14em;text-transform:uppercase;color:#D9C7B8"><span>01 · Website Design &amp; Development</span><span>Shrey</span></div>
      <h3 style="margin:0;font-family:'Cormorant Garamond',serif;font-weight:400;font-size:clamp(34px,3.8vw,54px);line-height:1.02;text-wrap:balance">Need a new website, redesign or custom functionality?</h3>
      <ul style="list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,190px),1fr));gap:0 24px;font-size:14px">
        <li style="padding:10px 0;border-top:1px solid rgba(247,244,239,0.25)">Website strategy &amp; UX</li>
        <li style="padding:10px 0;border-top:1px solid rgba(247,244,239,0.25)">Website &amp; responsive design</li>
        <li style="padding:10px 0;border-top:1px solid rgba(247,244,239,0.25)">Wix Studio, Wix CMS &amp; Velo</li>
        <li style="padding:10px 0;border-top:1px solid rgba(247,244,239,0.25)">WordPress &amp; Elementor</li>
        <li style="padding:10px 0;border-top:1px solid rgba(247,244,239,0.25)">HTML, CSS &amp; JavaScript</li>
        <li style="padding:10px 0;border-top:1px solid rgba(247,244,239,0.25)">Custom functionality &amp; CMS</li>
        <li style="padding:10px 0;border-top:1px solid rgba(247,244,239,0.25)">Integrations</li>
        <li style="padding:10px 0;border-top:1px solid rgba(247,244,239,0.25)">Technical implementation</li>
      </ul>
      <a class="hv-d0dd51" href="/contact/?need=New%20Website" style="align-self:flex-start;margin-top:auto;background:#F7F4EF;color:#2F2F2F;padding:15px 26px;font-size:14px;font-weight:500;white-space:nowrap">Build My Website →</a>
    </article>
    <article data-reveal style="flex:1 1 340px;min-width:0;border:1px solid #B7A89B;padding:clamp(28px,4vw,48px);display:flex;flex-direction:column;gap:22px">
      <div style="display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;font-size:12px;letter-spacing:0.14em;text-transform:uppercase;color:#7A5C49"><span>02 · Digital Marketing &amp; Strategy</span><span>Kenny</span></div>
      <h3 style="margin:0;font-family:'Cormorant Garamond',serif;font-weight:400;font-size:clamp(28px,2.8vw,38px);line-height:1.05;text-wrap:balance">Already have a website but need more people to find it, understand it or convert?</h3>
      <ul style="list-style:none;margin:0;padding:0;font-size:14px">
        <li style="padding:10px 0;border-top:1px solid #D7D3CF">Marketing strategy &amp; positioning</li>
        <li style="padding:10px 0;border-top:1px solid #D7D3CF">Content &amp; conversion strategy</li>
        <li style="padding:10px 0;border-top:1px solid #D7D3CF">Audience direction &amp; digital growth</li>
        <li style="padding:10px 0;border-top:1px solid #D7D3CF">Ongoing marketing support</li>
      </ul>
      <p style="margin:0;font-size:13px;line-height:1.6;color:#7A5C49">Add it to a website project or book it on its own.</p>
      <a class="hv-b9b180" href="/contact/?need=Digital%20Marketing" style="align-self:flex-start;margin-top:auto;border:1px solid #2F2F2F;color:#2F2F2F;padding:14px 24px;font-size:14px;font-weight:500;white-space:nowrap">Discuss Marketing →</a>
    </article>
  </div>
</section>

<AppsShowcase />

<section style="background:#D9C7B8">
  <div style="max-width:1360px;margin:0 auto;padding:clamp(80px,10vw,128px) clamp(20px,4vw,48px);display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,380px),1fr));gap:48px clamp(40px,6vw,96px)">
    <div data-reveal style="display:flex;flex-direction:column;gap:20px">
      <div style="font-size:12px;letter-spacing:0.16em;text-transform:uppercase;color:#6B4F3E;font-weight:500">Why both matter</div>
      <h2 style="margin:0;font-family:'Cormorant Garamond',serif;font-weight:400;font-size:clamp(38px,4.6vw,64px);line-height:1;text-wrap:balance">Strategy on one side. Execution on the other.</h2>
      <p style="margin:0;font-size:16px;line-height:1.65;max-width:440px">A website isn't just how it looks. Kenny brings the marketing perspective. Shrey brings the design and build. You don't have to coordinate multiple people for the core project.</p>
    </div>
    <div data-reveal style="display:flex;flex-direction:column;gap:14px">
      <span style="font-size:13px;font-weight:500">A website needs to:</span>
      <ul style="list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,200px),1fr));gap:0 28px">
        <li style="display:flex;justify-content:space-between;gap:12px;padding:14px 0;border-top:1px solid #7A5C49;font-size:15px"><span>Communicate clearly</span><span style="font-size:11px;letter-spacing:0.1em;text-transform:uppercase;color:#6B4F3E">Kenny</span></li>
        <li style="display:flex;justify-content:space-between;gap:12px;padding:14px 0;border-top:1px solid #7A5C49;font-size:15px"><span>Guide users</span><span style="font-size:11px;letter-spacing:0.1em;text-transform:uppercase;color:#355C63">Shrey</span></li>
        <li style="display:flex;justify-content:space-between;gap:12px;padding:14px 0;border-top:1px solid #7A5C49;font-size:15px"><span>Support the business</span><span style="font-size:11px;letter-spacing:0.1em;text-transform:uppercase;color:#6B4F3E">Kenny</span></li>
        <li style="display:flex;justify-content:space-between;gap:12px;padding:14px 0;border-top:1px solid #7A5C49;font-size:15px"><span>Function properly</span><span style="font-size:11px;letter-spacing:0.1em;text-transform:uppercase;color:#355C63">Shrey</span></li>
        <li style="display:flex;justify-content:space-between;gap:12px;padding:14px 0;border-top:1px solid #7A5C49;font-size:15px"><span>Convert visitors</span><span style="font-size:11px;letter-spacing:0.1em;text-transform:uppercase;color:#6B4F3E">Kenny</span></li>
        <li style="display:flex;justify-content:space-between;gap:12px;padding:14px 0;border-top:1px solid #7A5C49;font-size:15px"><span>Be easy to manage</span><span style="font-size:11px;letter-spacing:0.1em;text-transform:uppercase;color:#355C63">Shrey</span></li>
        <li style="display:flex;justify-content:space-between;gap:12px;padding:14px 0;border-top:1px solid #7A5C49;border-bottom:1px solid #7A5C49;font-size:15px"><span>Work across devices</span><span style="font-size:11px;letter-spacing:0.1em;text-transform:uppercase;color:#355C63">Shrey</span></li>
      </ul>
    </div>
  </div>
</section>

<section style="max-width:1360px;margin:0 auto;padding:clamp(80px,10vw,128px) clamp(20px,4vw,48px)">
  <div data-reveal style="display:flex;justify-content:space-between;align-items:flex-end;gap:24px;flex-wrap:wrap;margin-bottom:clamp(36px,4vw,56px)">
    <div style="display:flex;flex-direction:column;gap:14px">
      <div style="font-size:12px;letter-spacing:0.16em;text-transform:uppercase;color:#355C63;font-weight:500">What we can build</div>
      <h2 style="margin:0;font-family:'Cormorant Garamond',serif;font-weight:400;font-size:clamp(38px,4.6vw,64px);line-height:1">Websites for small businesses, e-commerce and Airbnb hosts.</h2>
    </div>
    <p style="margin:0;font-size:13px;line-height:1.6;max-width:320px;color:#7A5C49">Design concepts showing the types of sites we build. Not client projects.</p>
  </div>
  <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,340px),1fr));gap:40px 24px">
    {
      BUILD_TYPES.map((t) => (
        <article data-reveal style="display:flex;flex-direction:column;gap:14px">
          <div style="background:#D7D3CF;padding:6px"><div style="aspect-ratio:4/3"><ImageSlot id={t.imageId} /></div></div>
          <div style="display:flex;justify-content:space-between;align-items:baseline;gap:12px"><h3 style="margin:0;font-family:'Cormorant Garamond',serif;font-weight:500;font-size:26px">{t.title}</h3><span style="font-size:11px;letter-spacing:0.12em;text-transform:uppercase;color:#7A5C49">Concept</span></div>
          <p style="margin:0;font-size:14px;line-height:1.6">{t.text}</p>
        </article>
      ))
    }
  </div>
  <div data-reveal style="display:flex;justify-content:space-between;align-items:center;gap:20px;flex-wrap:wrap;margin-top:56px;padding:26px 0;border-top:1px solid #D7D3CF;border-bottom:1px solid #D7D3CF">
    <p style="margin:0;font-family:'Cormorant Garamond',serif;font-size:clamp(24px,2.4vw,32px);line-height:1.2">See your business in one of these?</p>
    <div style="display:flex;gap:14px 28px;align-items:center;flex-wrap:wrap">
      <a class="hv-87875d" href="/work/" style="font-size:14px;border-bottom:1px solid #2F2F2F;padding-bottom:3px;color:#2F2F2F;white-space:nowrap">See Our Work →</a>
      <a class="hv-b9b180" href="/contact/" style="background:#355C63;color:#F7F4EF;padding:15px 26px;font-size:14px;font-weight:500;white-space:nowrap">Start Your Project</a>
    </div>
  </div>
</section>

{
  /* Full edition only. In the launch edition the section above already shows the illustrative designs,
     so repeating them here as "selected experience" would only duplicate it. The Work page lists the project types. */
  !IS_LAUNCH && (
<section style="border-top:1px solid #D7D3CF">
  <div style="max-width:1360px;margin:0 auto;padding:clamp(80px,10vw,128px) clamp(20px,4vw,48px)">
    <div data-reveal style="display:flex;justify-content:space-between;align-items:flex-end;gap:20px;flex-wrap:wrap;margin-bottom:40px">
      <div style="display:flex;flex-direction:column;gap:14px">
        <div style="font-size:12px;letter-spacing:0.16em;text-transform:uppercase;color:#355C63;font-weight:500">Selected experience</div>
        <h2 style="margin:0;font-family:'Cormorant Garamond',serif;font-weight:400;font-size:clamp(34px,3.8vw,52px);line-height:1">Real projects we've delivered</h2>
      </div>
      <a class="hv-728b35" href="/work/" style="font-size:14px;color:#2F2F2F;white-space:nowrap">View More Work →</a>
    </div>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,300px),1fr));gap:40px 24px">
      {
        FEATURED.map((p) => (
          <a data-reveal href={p.caseStudy ?? '/work/'} style="display:flex;flex-direction:column;gap:14px;color:#2F2F2F">
            <div style="background:#D7D3CF;padding:6px"><div style="aspect-ratio:16/10"><ImageSlot id={p.imageId} /></div></div>
            <h3 style="margin:0;font-family:'Cormorant Garamond',serif;font-weight:500;font-size:26px;line-height:1.1">{p.name}</h3>
            <dl style="margin:0;display:grid;grid-template-columns:auto 1fr;gap:6px 14px;font-size:13px;line-height:1.5">
              <dt style="color:#7A5C49">Industry</dt><dd style="margin:0">{p.industry}</dd>
              <dt style="color:#7A5C49">Work</dt><dd style="margin:0">{p.work}</dd>
              {p.platform && (<><dt style="color:#7A5C49">Platform</dt><dd style="margin:0">{p.platform}</dd></>)}
            </dl>
          </a>
        ))
      }
    </div>
  </div>
</section>
  )
}

