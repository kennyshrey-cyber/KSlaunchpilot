---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ImageSlot from '../../components/ImageSlot.astro';
import { PAGES } from '../../data/site';
import { PROJECTS } from '../../data/projects';
---

<BaseLayout title={PAGES.work.title} description={PAGES.work.description}>
<section style="max-width:1360px;margin:0 auto;padding-left:clamp(20px,4vw,48px);padding-right:clamp(20px,4vw,48px);padding-top:clamp(40px,6vw,88px);padding-bottom:clamp(80px,10vw,128px)">
  <div style="display:flex;justify-content:space-between;align-items:flex-end;gap:24px;flex-wrap:wrap;margin-bottom:clamp(40px,5vw,64px)">
    <div style="display:flex;flex-direction:column;gap:20px">
      <div style="font-size:12px;letter-spacing:0.16em;text-transform:uppercase;color:#355C63;font-weight:500">Selected work</div>
      <h1 style="margin:0;font-family:'Cormorant Garamond',serif;font-weight:400;font-size:clamp(46px,6vw,88px);line-height:0.98;letter-spacing:-0.015em;text-wrap:balance;max-width:14ch">Websites we've designed and built.</h1>
    </div>
    <p style="margin:0;font-size:16px;line-height:1.6;max-width:380px">Hospitality, wellness, real estate and platform projects. Select a project to see what we did.</p>
  </div>
  <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,340px),1fr));gap:56px 24px">
    {
      PROJECTS.map((p) => {
        const href = p.caseStudy ?? p.url;
        const external = !p.caseStudy && !!p.url;
        const inner = (
          <>
            <div style="background:#D7D3CF;padding:7px"><div style="aspect-ratio:4/3"><ImageSlot id={p.imageId} /></div></div>
            <div style="display:flex;justify-content:space-between;align-items:baseline;gap:12px">
              <div style="display:flex;flex-direction:column;gap:6px">
                <h2 style="margin:0;font-family:'Cormorant Garamond',serif;font-weight:500;font-size:28px;line-height:1.1">{p.name}</h2>
                <span style="font-size:13px;color:#5A6851">{p.summary}</span>
              </div>
              {p.caseStudy && <span style="font-size:13px;white-space:nowrap">Case study →</span>}
              {external && <span style="font-size:13px;white-space:nowrap">Visit website ↗<span class="visually-hidden"> (opens in a new tab)</span></span>}
            </div>
          </>
        );
        return href ? (
          <a data-reveal href={href} target={external ? '_blank' : undefined} rel={external ? 'noopener' : undefined} style="display:flex;flex-direction:column;gap:16px;color:#2F2F2F">{inner}</a>
        ) : (
          <article data-reveal style="display:flex;flex-direction:column;gap:16px;color:#2F2F2F">{inner}</article>
        );
      })
    }
    </div>
  <div data-reveal style="display:flex;justify-content:space-between;align-items:center;gap:20px;flex-wrap:wrap;margin-top:64px;padding:26px 0;border-top:1px solid #D7D3CF;border-bottom:1px solid #D7D3CF">
    <p style="margin:0;font-family:'Cormorant Garamond',serif;font-size:clamp(24px,2.4vw,32px);line-height:1.2">Need something similar for your business?</p>
    <a class="hv-b9b180" href="/contact/" style="background:#355C63;color:#F7F4EF;padding:15px 26px;font-size:14px;font-weight:500;white-space:nowrap">Start Your Project</a>
  </div>
</section>

</BaseLayout>
