---
import BaseLayout from '../layouts/BaseLayout.astro';
import ImageSlot from '../components/ImageSlot.astro';
import VideoEmbed from '../components/VideoEmbed.astro';
import SocialIcon from '../components/SocialIcon.astro';
import { PAGES, SITE, SOCIALS } from '../data/site';
import { APPS } from '../data/apps';

const youtube = SOCIALS.find((s) => s.id === 'youtube')!;
---

<BaseLayout title={PAGES.apps.title} description={PAGES.apps.description}>
{
  Astro.site && (
    <script
      type="application/ld+json"
      slot="head"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@graph': APPS.map((app) => ({
          '@type': 'SoftwareApplication',
          name: app.name,
          description: app.summary,
          applicationCategory: 'BusinessApplication',
          operatingSystem: 'Web',
          url: app.marketUrl ?? new URL(`/apps/#${app.slug}`, Astro.site).href,
          publisher: { '@type': 'Organization', name: SITE.name, url: Astro.site!.href },
        })),
      })}
    />
  )
}
<section style="max-width:1360px;margin:0 auto;padding:clamp(40px,6vw,88px) clamp(20px,4vw,48px) clamp(48px,6vw,80px);display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,420px),1fr));gap:28px clamp(40px,6vw,96px);align-items:end">
  <div style="display:flex;flex-direction:column;gap:20px">
    <div style="font-size:12px;letter-spacing:0.16em;text-transform:uppercase;color:#355C63;font-weight:500">Apps · Live on the Wix App Market</div>
    <h1 style="margin:0;font-family:'Cormorant Garamond',serif;font-weight:400;font-size:clamp(46px,6vw,88px);line-height:0.98;letter-spacing:-0.015em;text-wrap:balance">Wix apps for developers and site owners.</h1>
  </div>
  <div style="display:flex;flex-direction:column;gap:22px;align-items:flex-start">
    <p style="margin:0;font-size:clamp(16px,1.3vw,18px);line-height:1.6;max-width:520px">We build websites for clients every week, so we build the tools we wish existed. Two of them are now released for every Wix designer, developer and site owner.</p>
    <ul style="list-style:none;margin:0;padding:0;display:flex;gap:10px;flex-wrap:wrap">
      {
        APPS.map((app) => (
          <li>
            <a class="hv-87875d" href={`#${app.slug}`} style="display:flex;align-items:center;gap:10px;border:1px solid #B7A89B;padding:8px 14px 8px 8px;font-size:14px;color:#2F2F2F">
              <span aria-hidden="true" style="width:28px;height:28px;border-radius:7px;overflow:hidden;display:block"><ImageSlot id={app.iconId} loading="eager" decorative /></span>
              {app.name} <span aria-hidden="true">↓</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

{
  APPS.map((app) => (
    <section
      id={app.slug}
      class="app-surface"
      data-surface="dark"
      style={`background:${app.theme.background};color:${app.theme.text};--accent:${app.theme.accent};scroll-margin-top:59px;border-top:1px solid rgba(255,255,255,0.14)`}
    >
      <div style="max-width:1360px;margin:0 auto;padding:clamp(72px,9vw,120px) clamp(20px,4vw,48px)">
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,440px),1fr));gap:48px clamp(40px,5vw,80px);align-items:center">
          <div data-reveal style="display:flex;flex-direction:column;gap:24px">
            <div style="display:flex;align-items:center;gap:14px 18px;flex-wrap:wrap">
              <span aria-hidden="true" style={`width:72px;height:72px;flex:none;border-radius:16px;overflow:hidden;border:1px solid ${app.theme.line}`}><ImageSlot id={app.iconId} decorative /></span>
              <div style="display:flex;flex-direction:column;gap:6px;min-width:0">
                <div style={`font-size:12px;letter-spacing:0.16em;text-transform:uppercase;color:${app.theme.accent};font-weight:500`}>{app.platform}</div>
                <h2 style="margin:0;font-family:'Cormorant Garamond',serif;font-weight:400;font-size:clamp(40px,5vw,68px);line-height:0.98">{app.name}</h2>
              </div>
            </div>
            <p style="margin:0;font-family:'Cormorant Garamond',serif;font-size:clamp(26px,2.600vw,34px);line-height:1.15;text-wrap:balance">{app.tagline}.</p>
            <p style={`margin:0;font-size:16px;line-height:1.7;max-width:540px;color:${app.theme.muted}`}>{app.summary}</p>
            <div style="display:flex;gap:14px 24px;align-items:center;flex-wrap:wrap;margin-top:4px">
              {app.marketUrl ? (
                <a class="hv-app-primary" href={app.marketUrl} target="_blank" rel="noopener" style={`background:${app.theme.text};color:${app.theme.background};padding:17px 28px;font-size:15px;font-weight:500`}>Get it on the Wix App Market ↗<span class="visually-hidden"> (opens in a new tab)</span></a>
              ) : (
                <p style={`margin:0;border:1px solid ${app.theme.line};padding:15px 20px;font-size:15px;line-height:1.5`}>Available now on the Wix App Market. Search “{app.name}”.</p>
              )}
              {app.helpUrl && (
                <a class="hv-accent" href={app.helpUrl} target="_blank" rel="noopener" style={`font-size:15px;color:${app.theme.text};border-bottom:1px solid ${app.theme.text};padding-bottom:3px`}>Help and setup guide ↗<span class="visually-hidden"> (opens in a new tab)</span></a>
              )}
              {app.guide && (
                <a class="hv-accent" href={app.guide.href} style={`font-size:15px;color:${app.theme.text};border-bottom:1px solid ${app.theme.text};padding-bottom:3px`}>{app.guide.label} →</a>
              )}
            </div>
          </div>
          <div data-reveal style={`border:1px solid ${app.theme.line};box-shadow:0 30px 60px -30px rgba(0,0,0,0.6)`}>
            <div style="aspect-ratio:4/3"><ImageSlot id={app.heroImageId} loading="eager" /></div>
          </div>
        </div>

        <div data-reveal style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,400px),1fr));gap:40px clamp(40px,6vw,96px);margin-top:clamp(56px,7vw,96px);align-items:start">
          <div style="display:flex;flex-direction:column;gap:16px">
            <h3 style="margin:0;font-family:'Cormorant Garamond',serif;font-weight:400;font-size:clamp(30px,3.200vw,42px);line-height:1.05">What it does</h3>
            {app.pricing && <p style={`margin:0;font-size:15px;line-height:1.65;max-width:440px;color:${app.theme.muted}`}>{app.pricing}</p>}
          </div>
          <ul style="list-style:none;margin:0;padding:0;display:flex;flex-direction:column;font-size:16px;line-height:1.55">
            {app.features.map((f, i) => (
              <li style={`display:flex;gap:14px;padding:16px 0;border-top:1px solid ${app.theme.line};${i === app.features.length - 1 ? `border-bottom:1px solid ${app.theme.line}` : ''}`}><span aria-hidden="true" style={`color:${app.theme.accent}`}>✓</span>{f}</li>
            ))}
          </ul>
        </div>

        {app.gallery.length > 0 && (
          <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,300px),1fr));gap:24px;margin-top:clamp(56px,7vw,96px)">
            {app.gallery.map((g) => (
              <figure data-reveal style="margin:0;display:flex;flex-direction:column;gap:12px">
                <div style={`border:1px solid ${app.theme.line}`}><div style="aspect-ratio:4/3"><ImageSlot id={g.imageId} /></div></div>
                <figcaption style={`font-size:14px;color:${app.theme.muted}`}>{g.caption}</figcaption>
              </figure>
            ))}
          </div>
        )}

        {app.video && (
          <div data-reveal style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,400px),1fr));gap:32px clamp(40px,6vw,96px);margin-top:clamp(56px,7vw,96px);align-items:center">
            <div style="display:flex;flex-direction:column;gap:16px">
              <div style={`font-size:12px;letter-spacing:0.16em;text-transform:uppercase;color:${app.theme.accent};font-weight:500`}>Watch the demo</div>
              <h3 style="margin:0;font-family:'Cormorant Garamond',serif;font-weight:400;font-size:clamp(30px,3.200vw,42px);line-height:1.05;text-wrap:balance">From pasted code to a live section in 90 seconds.</h3>
              <a class="hv-accent" href={youtube.href} target="_blank" rel="noopener" style={`align-self:flex-start;display:flex;align-items:center;gap:10px;font-size:14px;color:${app.theme.text};border-bottom:1px solid ${app.theme.text};padding-bottom:3px`}><SocialIcon id="youtube" size={18} />More on our YouTube channel ↗<span class="visually-hidden"> (opens in a new tab)</span></a>
            </div>
            <div style={`border:1px solid ${app.theme.line}`}>
              <VideoEmbed youtubeId={app.video.youtubeId} title={app.video.title} posterId={app.video.posterId} />
            </div>
          </div>
        )}
      </div>
    </section>
  ))
}

<section style="border-top:1px solid #D7D3CF">
  <div data-reveal style="max-width:1360px;margin:0 auto;padding:clamp(72px,9vw,120px) clamp(20px,4vw,48px);display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,400px),1fr));gap:32px clamp(40px,6vw,96px);align-items:start">
    <div style="display:flex;flex-direction:column;gap:16px">
      <div style="font-size:12px;letter-spacing:0.16em;text-transform:uppercase;color:#355C63;font-weight:500">Follow along</div>
      <h2 style="margin:0;font-family:'Cormorant Garamond',serif;font-weight:400;font-size:clamp(36px,4.400vw,60px);line-height:1;text-wrap:balance">Tutorials, demos and what we're building next.</h2>
    </div>
    <div style="display:flex;flex-direction:column;gap:20px">
      <p style="margin:0;font-size:16px;line-height:1.65;max-width:520px">We share Wix tips, app tutorials and what we learn building for the Wix App Market. Questions about either app? Email <a class="hv-87875d" href={`mailto:${SITE.email}`} style="border-bottom:1px solid #2F2F2F;padding-bottom:2px">{SITE.email}</a>.</p>
      <ul style="list-style:none;margin:0;padding:0;display:flex;gap:8px;flex-wrap:wrap">
        {
          SOCIALS.map((s) => (
            <li>
              <a class="hv-87875d" href={s.href} target="_blank" rel="noopener" style="display:flex;align-items:center;gap:8px;border:1px solid #B7A89B;padding:10px 14px;font-size:14px;color:#2F2F2F">
                <SocialIcon id={s.id} size={17} />{s.label}<span class="visually-hidden"> (opens in a new tab)</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<section data-surface="dark" style="background:#2F2F2F;color:#F7F4EF">
  <div data-reveal style="max-width:1360px;margin:0 auto;padding:clamp(88px,11vw,150px) clamp(20px,4vw,48px);display:flex;flex-direction:column;gap:28px;align-items:flex-start">
    <h2 style="margin:0;font-family:'Cormorant Garamond',serif;font-weight:400;font-size:clamp(48px,7vw,104px);line-height:0.98;letter-spacing:-0.01em">Need it built for you?</h2>
    <p style="margin:0;font-size:17px;line-height:1.6;max-width:520px;color:#D7D3CF">The same team that builds these apps designs and develops complete websites. Tell us what you're working on.</p>
    <a class="hv-d0dd51" href="/contact/" style="margin-top:8px;background:#F7F4EF;color:#2F2F2F;padding:17px 30px;font-size:15px;font-weight:500;white-space:nowrap">Start Your Project</a>
  </div>
</section>
</BaseLayout>
