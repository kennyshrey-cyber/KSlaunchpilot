---
/** Simple monochrome marks for the social links. Decorative: the link text carries the name. */
interface Props {
  id: 'youtube' | 'instagram' | 'x' | 'reddit';
  size?: number;
}
const { id, size = 18 } = Astro.props;
---

<svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {id === 'youtube' && (<><rect x="2.5" y="5.5" width="19" height="13" rx="3.5" /><path d="M10 9.2v5.6l5-2.800z" fill="currentColor" stroke="none" /></>)}
  {id === 'instagram' && (<><rect x="3.5" y="3.500" width="17" height="17" rx="4.500" /><circle cx="12" cy="12" r="3.800" /><circle cx="17" cy="7" r="0.900" fill="currentColor" stroke="none" /></>)}
  {id === 'x' && (<path d="M4.500 4.500l15 15M19.500 4.500l-15 15" />)}
  {id === 'reddit' && (<><ellipse cx="12" cy="13.500" rx="7.500" ry="5.500" /><circle cx="9.200" cy="13" r="1" fill="currentColor" stroke="none" /><circle cx="14.800" cy="13" r="1" fill="currentColor" stroke="none" /><path d="M9.500 16c1.500 1 3.500 1 5 0M12 8l1-4 4 1" /><circle cx="18.300" cy="5.200" r="1.300" /></>)}
</svg>
