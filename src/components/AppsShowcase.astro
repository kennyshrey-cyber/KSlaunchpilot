---
/** Homepage band announcing the two apps on the Wix App Market. Colours follow the KS LaunchPilot brand sheet. */
import ImageSlot from './ImageSlot.astro';
import { APPS } from '../data/apps';
---

<section id="apps" class="app-surface" data-surface="dark" style="background:#151C32;color:#FFFFFF;scroll-margin-top:60px;--accent:#A79BFF">
  <div style="max-width:1360px;margin:0 auto;padding:clamp(80px,10vw,128px) clamp(20px,4vw,48px)">
    <div data-reveal style="display:flex;justify-content:space-between;align-items:flex-end;gap:24px 48px;flex-wrap:wrap;margin-bottom:clamp(36px,4.500vw,56px)">
      <div style="display:flex;flex-direction:column;gap:16px">
        <div style="font-size:12px;letter-spacing:0.16em;text-transform:uppercase;color:#A79BFF;font-weight:500">Our apps · Live on the Wix App Market</div>
        <h2 style="margin:0;font-family:'Cormorant Garamond',serif;font-weight:400;font-size:clamp(40px,5vw,68px);line-height:1;text-wrap:balance;max-width:16ch">We also build apps for Wix sites.</h2>
      </div>
      <div style="display:flex;flex-direction:column;gap:16px;max-width:420px">
        <p style="margin:0;font-size:16px;line-height:1.65;color:#C9CEDD">Two tools that came out of our own client work, now released for every Wix designer, developer and site owner.</p>
        <a class="hv-accent" href="/apps/" style="align-self:flex-start;font-size:14px;color:#FFFFFF;border-bottom:1px solid #FFFFFF;padding-bottom:3px;white-space:nowrap">See both apps →</a>
      </div>
    </div>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,400px),1fr));gap:24px">
      {
        APPS.map((app) => (
          <article data-reveal style="display:flex;flex-direction:column;background:rgba(255,255,255,0.04);border:1px solid rgba(201,206,221,0.22)">
            <a href={`/apps/#${app.slug}`} tabindex="-1" aria-hidden="true" style="display:block;aspect-ratio:4/3;border-bottom:1px solid rgba(201,206,221,0.22)">
              <ImageSlot id={app.heroImageId} decorative />
            </a>
            <div style="display:flex;flex-direction:column;gap:18px;padding:clamp(22px,2.600vw,32px);flex:1">
              <div style="display:flex;align-items:center;gap:16px">
                <span aria-hidden="true" style="width:56px;height:56px;flex:none;border-radius:12px;overflow:hidden;border:1px solid rgba(201,206,221,0.22)"><ImageSlot id={app.iconId} decorative /></span>
                <div style="display:flex;flex-direction:column;gap:4px">
                  <h3 style="margin:0;font-family:'Cormorant Garamond',serif;font-weight:500;font-size:32px;line-height:1">{app.name}</h3>
                  <span style="font-size:14px;line-height:1.4;color:#C9CEDD">{app.tagline}</span>
                </div>
              </div>
              <ul style="list-style:none;margin:0;padding:0;display:flex;flex-direction:column;font-size:14px;line-height:1.5">
                {app.highlights.map((h) => (
                  <li style="display:flex;gap:12px;padding:10px 0;border-top:1px solid rgba(201,206,221,0.18)"><span aria-hidden="true" style="color:#A79BFF">✓</span>{h}</li>
                ))}
              </ul>
              <div style="font-size:12px;letter-spacing:0.12em;text-transform:uppercase;color:#A79BFF;font-weight:500">{app.platform}</div>
              <div style="display:flex;gap:14px 24px;align-items:center;flex-wrap:wrap;margin-top:auto;padding-top:6px">
                {app.marketUrl ? (
                  <a class="hv-app-primary" href={app.marketUrl} target="_blank" rel="noopener" style="background:#FFFFFF;color:#151C32;padding:14px 22px;font-size:14px;font-weight:500;white-space:nowrap">Get it on the Wix App Market ↗<span class="visually-hidden"> (opens in a new tab)</span></a>
                ) : (
                  <a class="hv-app-primary" href={`/apps/#${app.slug}`} style="background:#FFFFFF;color:#151C32;padding:14px 22px;font-size:14px;font-weight:500;white-space:nowrap">See {app.name} →</a>
                )}
                {app.marketUrl ? (
                  <a class="hv-accent" href={`/apps/#${app.slug}`} style="font-size:14px;color:#FFFFFF;border-bottom:1px solid #FFFFFF;padding-bottom:3px;white-space:nowrap">Learn more →</a>
                ) : (
                  <span style="font-size:13px;line-height:1.5;color:#C9CEDD">Search “{app.name}” on the Wix App Market.</span>
                )}
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
