---
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-500.css';
import '@fontsource/cormorant-garamond/latin-400.css';
import '@fontsource/cormorant-garamond/latin-500.css';
import interRegular from '@fontsource/inter/files/inter-latin-400-normal.woff2?url';
import cormorantRegular from '@fontsource/cormorant-garamond/files/cormorant-garamond-latin-400-normal.woff2?url';
import '../styles/global.css';
import '../styles/hover.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import StickyCta from '../components/StickyCta.astro';
import { SITE } from '../data/site';

interface Props {
  title: string;
  description: string;
  /** Hide from search engines (thank-you, privacy placeholder, 404). */
  noindex?: boolean;
  /** The design turns the sticky CTA off on the Contact page. */
  stickyCta?: boolean;
  ogType?: 'website' | 'article';
}

const { title, description, noindex = false, stickyCta = true, ogType = 'website' } = Astro.props;
const site = Astro.site;
const canonical = site && !noindex ? new URL(Astro.url.pathname, site).href : undefined;
const ogImage = site ? new URL('/og-image.png', site).href : undefined;
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#F7F4EF" />

    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <link rel="preload" href={cormorantRegular} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={interRegular} as="font" type="font/woff2" crossorigin />

    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta property="og:image:width" content="1200" />}
    {ogImage && <meta property="og:image:height" content="630" />}
    {ogImage && <meta property="og:image:alt" content="KS Launchpilot: website design, development & digital marketing" />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader />
    <main id="main" tabindex="-1" style="outline:none">
      <slot />
    </main>
    <SiteFooter />
    {stickyCta && <StickyCta />}
    <script>
      import '../scripts/site.ts';
    </script>
  </body>
</html>
