# Final production URL, used for canonical links, Open Graph URLs and the sitemap.
# Leave unset until the domain is confirmed. On Netlify the platform URL is used automatically.
SITE_URL=

# Contact form delivery. "netlify" (Netlify Forms, no key needed) or "formspree".
PUBLIC_FORM_PROVIDER=netlify
# Only for formspree: the form endpoint, e.g. https://formspree.io/f/xxxxxxx
PUBLIC_FORM_ENDPOINT=
